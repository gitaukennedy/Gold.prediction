# Copy to .env and fill values
ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets
TICKER=GC=F
DATA_INTERVAL=1m
DATA_PERIOD=2d
MARKET_DATA_MAX_AGE_MINUTES=30
BUY_THRESHOLD=0.55
SELL_THRESHOLD=0.55
MINIMUM_WIN_RATE=0.52
TRADE_QTY=1
ENABLE_TRADING=false
# Fallback only; normal exits use ATR and the recent high/low range below.
STOP_LOSS_PCT=0.01
TAKE_PROFIT_PCT=0.02
RISK_LOOKBACK_BARS=20
SIMULATION_HORIZON_BARS=5
TRADE_SYMBOL=GLD
